{
  "name": "weour-matrimony-backend",
  "version": "1.0.0",
  "description": "WeOur Matrimony API - Node.js, Express & TypeScript Backend",
  "private": true,
  "license": "MIT",
  "main": "dist/server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "seed:test-users": "cross-env NODE_ENV=development ts-node -r tsconfig-paths/register src/scripts/seedTestUsers.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "npm run build && cross-env NODE_ENV=production node dist/server.js",
    "dev": "npm run typecheck && npm run build && cross-env NODE_ENV=development nodemon",
    "build": "swc src -d dist --copy-files",
    "build:tsc": "tsc && tsc-alias",
    "pretest": "swc src -d dist --copy-files",
    "test": "jest --coverage --verbose --watchAll=false",
    "lint": "eslint --ignore-path .gitignore --ext .ts src/",
    "lint:fix": "npm run lint -- --fix",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.33.0",
    "@httpx/exception": "^3.1.12",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "multer": "^2.2.0",
    "nanoid": "^3.3.16",
    "razorpay": "^2.9.8",
    "reflect-metadata": "^0.2.2",
    "sharp": "^0.35.3",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "swc": "^1.0.11",
    "typedi": "^0.10.0",
    "uuid": "^11.1.1",
    "winston": "^3.19.0",
    "xss-clean": "^0.1.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.3.0",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.39.1",
    "@typescript-eslint/parser": "^8.39.1",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "jest": "^30.0.5",
    "mongodb-memory-server": "^10.4.3",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
